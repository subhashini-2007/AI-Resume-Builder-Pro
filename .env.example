# Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database Configurations (Neon PostgreSQL)
# Used for connection pooling (Transaction Mode)
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Used for migrations (Session Mode)
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Sessions
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters

# AI Services (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here


# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
