generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  aiHistory     AIHistory[]
  coverLetters  CoverLetter[]
  notifications Notification[]
  resumes       Resume[]
  subscription  Subscription?
  settings      UserSettings?
  tasks         UserTask[]

  @@index([email])
}

model UserSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  theme              String   @default("system")
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @db.Uuid
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resume {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  title            String          @default("Untitled Resume")
  summary          String          @default("")
  selectedTemplate String          @default("ats-classic")
  status           DocumentStatus  @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  avatar           String          @default("")
  email            String          @default("")
  fullName         String          @default("")
  location         String          @default("")
  phone            String          @default("")
  website          String          @default("")
  behanceUrl       String          @default("")
  devtoUrl         String          @default("")
  dribbbleUrl      String          @default("")
  githubUrl        String          @default("")
  googleScholarUrl String          @default("")
  hackerrankUrl    String          @default("")
  kaggleUrl        String          @default("")
  leetcodeUrl      String          @default("")
  linkedinUrl      String          @default("")
  mediumUrl        String          @default("")
  orcidUrl         String          @default("")
  otherLinkLabel   String          @default("")
  otherLinkUrl     String          @default("")
  portfolioUrl     String          @default("")
  researchgateUrl  String          @default("")
  stackoverflowUrl String          @default("")
  twitterUrl       String          @default("")
  youtubeUrl       String          @default("")
  atsReports       ATSReport[]
  awards           Award[]
  certifications   Certification[]
  educations       Education[]
  experiences      Experience[]
  interests        Interest[]
  languages        Language[]
  projects         Project[]
  references       Reference[]
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections         ResumeSection[]
  versions         ResumeVersion[]
  skills           Skill[]

  @@index([userId])
  @@index([status])
}

model ResumeVersion {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  title     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSection {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  title     String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Experience {
  id          String   @id @default(uuid()) @db.Uuid
  resumeId    String   @db.Uuid
  company     String
  role        String
  startDate   String
  endDate     String
  description String
  isCurrent   Boolean  @default(false)
  location    String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Education {
  id           String   @id @default(uuid()) @db.Uuid
  resumeId     String   @db.Uuid
  school       String
  degree       String
  fieldOfStudy String   @default("")
  startDate    String
  endDate      String
  grade        String   @default("")
  description  String   @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  name      String
  level     String   @default("Intermediate")
  category  String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Project {
  id               String   @id @default(uuid()) @db.Uuid
  resumeId         String   @db.Uuid
  name             String
  description      String
  role             String   @default("")
  url              String   @default("")
  startDate        String   @default("")
  endDate          String   @default("")
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  achievements     String[] @default([])
  clientName       String   @default("")
  documentationUrl String   @default("")
  duration         String   @default("")
  githubUrl        String   @default("")
  keyFeatures      String[] @default([])
  liveUrl          String   @default("")
  projectType      String   @default("Personal")
  responsibilities String   @default("")
  status           String   @default("Completed")
  teamSize         String   @default("")
  technologies     String   @default("")
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Certification {
  id         String   @id @default(uuid()) @db.Uuid
  resumeId   String   @db.Uuid
  name       String
  issuer     String
  issueDate  String   @default("")
  expiryDate String   @default("")
  url        String   @default("")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Language {
  id          String   @id @default(uuid()) @db.Uuid
  resumeId    String   @db.Uuid
  name        String
  proficiency String   @default("Full Professional")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Award {
  id          String   @id @default(uuid()) @db.Uuid
  resumeId    String   @db.Uuid
  title       String
  issuer      String
  date        String
  description String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Interest {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model Reference {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  name      String
  title     String
  company   String
  email     String   @default("")
  phone     String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  category  String
  styles    Json
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model CoverLetter {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  jobTitle  String
  company   String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ATSReport {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  jobTitle  String
  score     Int
  details   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model AIHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  actionType  String
  prompt      String
  response    String
  creditsUsed Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("info")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model UserTask {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  status    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
  @@index([userId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
